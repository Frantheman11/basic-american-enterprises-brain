{
  "$comment": "Second brain guardrails, enforced by Claude Code itself rather than asked for in CLAUDE.md (knowledge base: 'enforce rules at the tool level, not in the prompt'). The pulled website cannot be edited (filed raw files stay editable only so a secret found later can be removed); history cannot be rewritten; secret files cannot be read. A secret in raw/inbox/ is removed BEFORE filing, so these rules never block that. The allow list pre-approves only what the setup itself does on this computer (open the inbox folder, save with git, run the brain check), so the owner is not asked to approve each one. Reading their website still asks once.",
  "permissions": {
    "deny": [
      "Edit(./raw/website/**)",
      "Write(./raw/website/**)",
      "Read(./.env)",
      "Read(./**/*.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(git clean:*)"
    ],
    "allow": [
      "Bash(explorer raw\\\\inbox)",
      "Bash(explorer.exe raw\\\\inbox)",
      "Bash(open raw/inbox)",
      "PowerShell(explorer raw\\inbox)",
      "PowerShell(explorer.exe raw\\inbox)",
      "PowerShell(Invoke-Item raw\\inbox)",
      "Bash(git --version)",
      "Bash(git status:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "PowerShell(git --version)",
      "PowerShell(git status:*)",
      "PowerShell(git init:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git log:*)",
      "PowerShell(git mv:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git push)",
      "PowerShell(git push origin:*)",
      "Bash(python --version)",
      "Bash(py --version)",
      "Bash(python tools/brain_check.py:*)",
      "Bash(py tools/brain_check.py:*)",
      "PowerShell(python --version)",
      "PowerShell(py --version)",
      "PowerShell(python tools/brain_check.py:*)",
      "PowerShell(py tools/brain_check.py:*)",
      "PowerShell(Move-Item raw\\inbox:*)",
      "Bash(mv raw/inbox/:*)",
      "PowerShell(New-Item -ItemType Directory raw:*)",
      "Bash(mkdir -p raw/:*)"
    ]
  }
}
